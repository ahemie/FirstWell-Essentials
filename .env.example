# FirstWell Essentials — copy this file to ".env" (same folder as app.py) and fill in your values.
# .env is ignored by git: never commit it. Run locally with:  py manage.py serve  ->  http://127.0.0.1:5503/login

# --- Supabase (your FirstWell Essentials project) -------------------------------------------
# Supabase > Project Settings > API: "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase > Project Settings > API Keys: publishable key (sb_publishable_...) or the legacy "anon" key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Supabase > Project Settings > API Keys: secret key (sb_secret_...) or legacy "service_role" key. Server only — keep private.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Login ------------------------------------------------------------------------------------
# Who may sign in to the dashboard (comma-separated). Each person also needs a Supabase Auth user.
ALLOWED_EMAILS=you@example.com

# --- Price Watch (optional — only if you use competitor scraping) ------------------------------
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
# APIFY_ACTOR_ID=xtracto/shopee-search
# OWN_SHOP_IDS=994773440,1688602696
# MAX_CHARGE_PER_RUN_USD=0.25
# MAX_RESULTS_PER_PRODUCT=10
# SEARCH_CANDIDATES_PER_RUN=30
# APIFY_TIMEOUT_SECS=75
# SCRAPE_SORT=sales

# Do NOT set VERCEL locally: it switches the app to Vercel mode (secure-only cookies).
